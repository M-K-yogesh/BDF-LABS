  "item": [
    {
      "name": "List books (defaults)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 with a list and pagination', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.be.an('array');",
              "  pm.expect(body.pagination).to.include({ limit: 10, offset: 0 });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create book (valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman - Hobbit\",\n  \"author\": \"J.R.R. Tolkien\",\n  \"price\": 12\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('creates a book with 201', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.message).to.eql('Book created');",
              "  pm.expect(body.data.id).to.be.a('number');",
              "  pm.collectionVariables.set('bookId', body.data.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get book by id (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/books/{{bookId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('retrieves single book with 200', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.message).to.eql('Book retrieved');",
              "  pm.expect(body.data.id).to.eql(Number(pm.collectionVariables.get('bookId')));",
              "});"
            ]
          }
        }
