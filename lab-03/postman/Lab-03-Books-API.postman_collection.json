    {
      "name": "Search, filter, sort, and paginate",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?search_q=Postman&min_price=10&max_price=20&order_by=price&order=DESC&limit=10&offset=0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "search_q",
              "value": "Postman"
            },
            {
              "key": "min_price",
              "value": "10"
            },
            {
              "key": "max_price",
              "value": "20"
            },
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns matching books in descending price order', function () {",
              "  pm.response.to.have.status(200);",
              "  const books = pm.response.json().data;",
              "  pm.expect(books.length).to.be.at.least(2);",
              "  books.forEach(function (book) {",
              "    pm.expect(book.title.toLowerCase()).to.include('postman');",
              "    pm.expect(book.price).to.be.within(10, 20);",
              "  });",
              "  for (let i = 1; i < books.length; i += 1) {",
              "    pm.expect(books[i - 1].price).to.be.at.least(books[i].price);",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
