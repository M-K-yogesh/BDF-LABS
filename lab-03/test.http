### Configuration Variables (Defaults)
@baseUrl = http://localhost:3000
@debugUrl = http://localhost:3001

###############################################################################
# 1. GET /books - LISTING, SEARCH, FILTERING, SORTING & PAGINATION
###############################################################################

### 1.1 List all books (with default parameters: order_by=id, order=ASC, limit=10, offset=0)
# URL: http://localhost:3000/books
GET http://localhost:3000/books
Accept: application/json

###

### 1.2 Search books by title (partial match via SQL LIKE)
# URL: http://localhost:3000/books?search_q=Hobbit
GET http://localhost:3000/books?search_q=Hobbit
Accept: application/json

###

### 1.3 Filter books by price range (min_price and max_price using BETWEEN)
# URL: http://localhost:3000/books?min_price=10&max_price=20
GET http://localhost:3000/books?min_price=10&max_price=20
Accept: application/json

###

### 1.4 Filter books with min_price only
# URL: http://localhost:3000/books?min_price=15
GET http://localhost:3000/books?min_price=15
Accept: application/json

###

### 1.5 Filter books with max_price only
# URL: http://localhost:3000/books?max_price=15
GET http://localhost:3000/books?max_price=15
Accept: application/json

###

### 1.6 Sort books by price descending (order_by=price, order=DESC)
# URL: http://localhost:3000/books?order_by=price&order=DESC
GET http://localhost:3000/books?order_by=price&order=DESC
Accept: application/json

###

### 1.7 Sort books by title ascending (order_by=title, order=ASC)
# URL: http://localhost:3000/books?order_by=title&order=ASC
GET http://localhost:3000/books?order_by=title&order=ASC
Accept: application/json

###

### 1.8 Paginate books (limit=2, offset=0 - Page 1)
# URL: http://localhost:3000/books?limit=2&offset=0
GET http://localhost:3000/books?limit=2&offset=0
Accept: application/json

###

### 1.9 Paginate books (limit=2, offset=2 - Page 2)
# URL: http://localhost:3000/books?limit=2&offset=2
GET http://localhost:3000/books?limit=2&offset=2
Accept: application/json

###

### 1.10 Combined Query: Search + Price Range + Sort + Pagination
# URL: http://localhost:3000/books?search_q=The&min_price=10&max_price=25&order_by=price&order=DESC&limit=5&offset=0
GET http://localhost:3000/books?search_q=The&min_price=10&max_price=25&order_by=price&order=DESC&limit=5&offset=0
Accept: application/json

###

###############################################################################
# 2. GET /books/:id - RETRIEVE SINGLE BOOK
###############################################################################

### 2.1 Get single book by existing ID (Expect 200 OK)
# URL: http://localhost:3000/books/1
GET http://localhost:3000/books/1
Accept: application/json

###

### 2.2 Get book by non-existent ID (Expect 404 Not Found)
# URL: http://localhost:3000/books/999999
GET http://localhost:3000/books/999999
Accept: application/json

###

### 2.3 Get book with invalid ID format (Expect 400 Bad Request)
# URL: http://localhost:3000/books/invalid-id
GET http://localhost:3000/books/invalid-id
Accept: application/json

###

###############################################################################
# 3. POST /books - CREATE NEW BOOK (VALIDATION TESTS)
###############################################################################

### 3.1 Create book with valid body (Expect 201 Created)
# URL: http://localhost:3000/books
POST http://localhost:3000/books
Content-Type: application/json

{
  "title": "The Hobbit",
  "author": "J.R.R. Tolkien",
  "price": 14.99
}

###

### 3.2 Create second book fixture
# URL: http://localhost:3000/books
POST http://localhost:3000/books
Content-Type: application/json

{
  "title": "The Fellowship of the Ring",
  "author": "J.R.R. Tolkien",
  "price": 19.99
}

###

### 3.3 Create third book fixture
# URL: http://localhost:3000/books
POST http://localhost:3000/books
Content-Type: application/json

{
  "title": "A Wizard of Earthsea",
  "author": "Ursula K. Le Guin",
  "price": 9.50
}

###

### 3.4 Create book: Missing title (Expect 400 Bad Request - "title is required")
# URL: http://localhost:3000/books
POST http://localhost:3000/books
Content-Type: application/json

{
  "author": "J.R.R. Tolkien",
  "price": 12.00
}

###

### 3.5 Create book: Missing author (Expect 400 Bad Request - "author is required")
# URL: http://localhost:3000/books
POST http://localhost:3000/books
Content-Type: application/json

{
  "title": "Untitled Masterpiece",
  "price": 15.00
}

###

### 3.6 Create book: Non-numeric price (Expect 400 Bad Request - "price must be a number")
# URL: http://localhost:3000/books
POST http://localhost:3000/books
Content-Type: application/json

{
  "title": "The Silmarillion",
  "author": "J.R.R. Tolkien",
  "price": "fifteen"
}

###

### 3.7 Create book: Malformed JSON body (Expect 400 Bad Request - "Invalid JSON request body")
# URL: http://localhost:3000/books
POST http://localhost:3000/books
Content-Type: application/json

{"title": "Broken JSON

###

###############################################################################
# 4. PUT /books/:id - UPDATE EXISTING BOOK
###############################################################################

### 4.1 Update an existing book (Expect 200 OK)
# URL: http://localhost:3000/books/1
PUT http://localhost:3000/books/1
Content-Type: application/json

{
  "title": "The Hobbit: 75th Anniversary Edition",
  "author": "J.R.R. Tolkien",
  "price": 16.50
}

###

### 4.2 Update non-existent book (Expect 404 Not Found)
# URL: http://localhost:3000/books/999999
PUT http://localhost:3000/books/999999
Content-Type: application/json

{
  "title": "Non-existent Book",
  "author": "Ghost Writer",
  "price": 20.00
}

###

### 4.3 Update with invalid payload (Expect 400 Bad Request - missing author)
# URL: http://localhost:3000/books/1
PUT http://localhost:3000/books/1
Content-Type: application/json

{
  "title": "Missing Author Book",
  "price": 10.00
}

###

###############################################################################
# 5. DELETE /books/:id - DELETE BOOK
###############################################################################

### 5.1 Delete an existing book (Expect 200 OK)
# URL: http://localhost:3000/books/1
DELETE http://localhost:3000/books/1
Accept: application/json

###

### 5.2 Delete non-existent or already deleted book (Expect 404 Not Found)
# URL: http://localhost:3000/books/1
DELETE http://localhost:3000/books/1
Accept: application/json

###

###############################################################################
# 6. EDGE CASES & ERROR HANDLING
###############################################################################

### 6.1 Unsupported sort column (Expect 400 Bad Request)
# URL: http://localhost:3000/books?order_by=secret_password
GET http://localhost:3000/books?order_by=secret_password
Accept: application/json

###

### 6.2 Invalid order direction (Expect 400 Bad Request)
# URL: http://localhost:3000/books?order=SIDEWAYS
GET http://localhost:3000/books?order=SIDEWAYS
Accept: application/json

###

### 6.3 Reversed price range: min_price > max_price (Expect 400 Bad Request)
# URL: http://localhost:3000/books?min_price=50&max_price=10
GET http://localhost:3000/books?min_price=50&max_price=10
Accept: application/json

###

### 6.4 Invalid pagination limit: out of range (Expect 400 Bad Request)
# URL: http://localhost:3000/books?limit=500
GET http://localhost:3000/books?limit=500
Accept: application/json

###

### 6.5 Request unknown route (Expect 404 Not Found - "Route not found")
# URL: http://localhost:3000/unknown-resource
GET http://localhost:3000/unknown-resource
Accept: application/json

###

###############################################################################
# 7. DEBUGGING EXERCISE SERVER (Port 3001)
###############################################################################

### 7.1 Verify Fixed Debugging Server (Run: npm run debug:fixed)
# URL: http://localhost:3001/books
GET http://localhost:3001/books
Accept: application/json
